.venv/
# Second venv for fish-s2 only -- fish-speech pins torch==2.8.0 and would
# clobber the CUDA torch the other two backends run on, so it is installed
# separately and synthesize.py --model fish-s2 runs under this interpreter.
.venv-fish/
__pycache__/
*.pyc

# fish-speech inference code + s2-pro weights (cloned, not vendored).
# See evaluation/README.md; FISH_SPEECH_DIR points here.
fish-speech/

# Synthesized audio -- regenerable, and large. The scores/reports derived from
# it (json, csv, md) ARE tracked; they're the deliverable.
evaluation/results/**/audio/

# DNSMOS model files -- downloaded from microsoft/DNS-Challenge, see
# evaluation/README.md
evaluation/dnsmos_models/
*.onnx

# LibreOffice lock files
.~lock.*#

# Generated listening-test pages: 6+ MB of base64 audio, rebuilt per study
# (different --pair/--seed = a new blob every time). Regenerate with
# evaluation/listening_test.py; the answer key IS tracked.
evaluation/listening_test.html

# Fine-tuning (finetune/): extracted training audio, LoRA checkpoints, TB logs
# and swept output are all regenerable and large. The manifests are excluded
# too -- they carry absolute paths into a corpus outside this repo. The corpus
# metadata, the verification results and the docs ARE tracked.
finetune/data*/wavs/
finetune/data*/*.jsonl
finetune/checkpoints/
finetune/logs/
finetune/results/audio/
# per-checkpoint sweep audio and logs from select_checkpoint.sh
finetune/results/select*/
finetune/results/audio*/
# demo clips and the page built from them; both regenerate from a checkpoint
finetune/results/demo/

# Probe experiments: checkpoints, TB logs, generated manifests. The scripts and
# the result json are tracked; everything they regenerate is not.
finetune/experiments/ckpt_*/
finetune/experiments/logs_*/
finetune/experiments/data/
finetune/experiments/sens_*.jsonl
finetune/experiments/*.log
finetune/experiments/probe_*.yaml

# Upstream VoxCPM trainer -- cloned, not vendored. See finetune/README.md.
VoxCPM-src/

# Parenthetical-prompt measurement (verify_parenthetical.py): the clips are 39 MB
# and regenerate from the base model. The .md/.json ARE tracked -- they are the
# result that stopped the fine-tune.
finetune/results/parenthetical/audio/
finetune/results/*.log

# Microsoft Office lock files -- created while a .docx is open, never content.
~$*

# NVV tag-expansion experiment: downloaded corpus, extracted wavs, and the
# synthesized sweeps. The manifests' metadata, the scripts and the built
# listening page's inputs are regenerable from these; the corpus is 3 GB.
finetune/data-nvv/NonverbalTTS/
finetune/data-nvv/wavs/
finetune/data-nvv/manifests/*.jsonl
finetune/results/nvv/*/audio/
finetune/results/nvv/*.html

# Scratch manifests written per-run by nvv_tag_sensitivity.py; the results json
# next to them is the tracked output.
finetune/results/nvv/_sens/

# Prompt-bank sweep (sweep_prosody_prompts.py): 161 MB of clips, regenerable
# from the base model in about two hours. rows.jsonl, the .md/.json summaries
# and prompt_cer.json ARE tracked -- they are the measurement.
finetune/results/prompt_sweep/audio/

# Held-out listening set for the NVV run: copies of NonverbalTTS originals plus
# the generated sweeps. heldout_meta.json is tracked; the wavs are not.
finetune/data-nvv/heldout/originals/
finetune/results/nvv/heldout_*/
finetune/results/prompt_sweep/*.html

# Style-reference sweep (sweep_style_reference.py): generated clips and the
# built page. rows.jsonl, references.json and the summaries ARE tracked.
finetune/results/style_reference/audio/
finetune/results/style_reference/*.html
